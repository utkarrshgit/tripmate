APP_NAME=TripMate
APP_VERSION=0.1.0
DEBUG=true

# PostgreSQL (Homebrew: brew install postgresql@18 && brew services start postgresql@18).
# ./run.sh creates both databases and runs the migrations.
DATABASE_URL=postgresql+asyncpg://localhost:5432/tripmate
TEST_DATABASE_URL=postgresql+asyncpg://localhost:5432/tripmate_test

# Browsers allowed to call the API with cookies (comma-separated)
CORS_ORIGINS=http://localhost:5173

# Signs 6-digit email codes. Make your own: python -c "import secrets; print(secrets.token_hex(32))"
OTP_SECRET=change-me-in-env

# Email: console (codes printed in the API log) or smtp (e.g. Mailpit on localhost:1025)
MAIL_MODE=console
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=TripMate <hello@tripmate.local>
# Development only: include each emailed code in the API response, so the website shows it. Never in production.
DEV_SHOW_CODES=true

# Ollama and the three models: one general LLM, one decision model, one embedding model
# false plans with rules only (the planner still works without Ollama either way)
AI_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=gemma4:e2b-mlx
OLLAMA_DECISION_MODEL=tev1:0.8b
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b

# Exact pricing: none | sample (made-up prices for development — never use in production)
PRICING_PROVIDER=sample
